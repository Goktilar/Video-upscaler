<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#333333"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#666666"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#E1E1E1"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#D0D0D0"/>
</ResourceDictionary>
